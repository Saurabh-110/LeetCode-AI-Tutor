# Copy this file to .env and fill in your values. Never commit .env.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional. Gemini model used for replies (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Rate limits per client IP
# RATE_LIMIT_DEFAULT=60 per minute
# RATE_LIMIT_HINT=30 per minute

# Optional. Port for `python app.py` (default 5000)
# PORT=5000

# Development only. Enables Flask debug mode.
# FLASK_DEBUG=false
